[Unit]
Description=Start The Spread's Listener stats workflow twice a day

[Timer]
# Same slots as stats.yml's schedule (GitHub's is the fallback). The workflow waits for the day's
# episode on weekdays, so the 18:37 run covers a late one.
OnCalendar=*-*-* 10,18:37:00 UTC
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
