[Unit]
Description=Run The Spread's daily brief and episode on this machine
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
# One user for all three jobs: they share the clone in the state directory.
User=the-spread
StateDirectory=the-spread
Environment=HOME=/var/lib/the-spread
EnvironmentFile=/etc/the-spread/env
LoadCredential=github-token:/etc/the-spread/github-token
ExecStart=/usr/local/bin/the-spread-run daily
TimeoutStartSec=2h
