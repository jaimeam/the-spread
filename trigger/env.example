# Secrets for the-spread-run, installed as /etc/the-spread/env (root only).
# Same names as the GitHub secrets. Blank optional lines are fine.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OP3_TOKEN=
# Optional
EIA_API_KEY=
AGSI_API_KEY=
MISTRAL_API_KEY=
# Optional model overrides, "provider:model" (same as the GitHub variables)
TAG_MODEL=
BRIEF_MODEL=
SCRIPT_MODEL=
# Python 3.11+ if python3 on this machine is older, e.g. PYTHON=/usr/bin/python3.12
PYTHON=
