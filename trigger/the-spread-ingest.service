[Unit]
Description=Run The Spread's feed ingest on this machine
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=the-spread
Environment=HOME=/var/lib/the-spread
EnvironmentFile=/etc/the-spread/env
LoadCredential=github-token:/etc/the-spread/github-token
ExecStart=/usr/local/bin/the-spread-run ingest
TimeoutStartSec=2h
