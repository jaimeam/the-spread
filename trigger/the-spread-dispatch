#!/bin/bash
# Starts The Spread daily workflow on GitHub (workflow_dispatch with skip_if_done=true,
# so it does nothing if today's episode already exists). Run by the-spread-trigger.service.
#   the-spread-dispatch          start the workflow
#   the-spread-dispatch --check  only check the token may start the workflow (starts nothing)
set -uo pipefail

url=https://api.github.com/repos/jaimeam/the-spread/actions/workflows/daily.yml
token_file=${CREDENTIALS_DIRECTORY:-/etc/the-spread}/github-token
token=$(<"$token_file") || { echo "cannot read $token_file"; exit 1; }
auth=(-H "Authorization: Bearer $token" -H "Accept: application/vnd.github+json"
      -H "X-GitHub-Api-Version: 2022-11-28" -H "Content-Type: application/json")

# Dispatch to a branch that doesn't exist: GitHub checks permission first (401 bad token,
# 403 no Actions write), then rejects the branch (422). So 422 means the token is right.
if [ "${1:-}" = --check ]; then
  code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 30 -X POST "${auth[@]}" \
    "$url/dispatches" -d '{"ref":"no-such-branch-permission-check"}')
  case $code in
    422) echo "token OK: it may start the workflow"; exit 0 ;;
    401) echo "HTTP 401: token invalid or expired" ;;
    403) echo "HTTP 403: token lacks Actions read and write on the-spread" ;;
    *)   echo "HTTP $code: unexpected" ;;
  esac
  exit 1
fi

# The timer is Persistent: a Friday run missed while the machine was off fires at the next boot,
# maybe on a weekend, and skip_if_done would find no brief for that day and make an episode.
if [ "$(date -u +%u)" -gt 5 ]; then echo "weekend (UTC): nothing to do"; exit 0; fi

# Retry network failures (e.g. right after waking from suspend) and GitHub 5xx/429.
# Stop at once on success (204) or any other 4xx: a bad or expired token won't fix itself.
for attempt in $(seq 1 20); do
  code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 30 -X POST "${auth[@]}" \
    "$url/dispatches" -d '{"ref":"main","inputs":{"skip_if_done":"true"}}') || code=000
  case $code in
    204) echo "workflow started (attempt $attempt)"; exit 0 ;;
    000|429|5??) echo "attempt $attempt: HTTP $code, retrying in 30s"; sleep 30 ;;
    *) echo "HTTP $code: not retrying (check the token: Actions read and write on the-spread)"; exit 1 ;;
  esac
done
echo "gave up after $attempt attempts"; exit 1
